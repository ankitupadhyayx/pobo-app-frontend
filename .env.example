# Base URL of the POBO API (include /api/v1).
# - iOS simulator / web on this Mac:  http://localhost:8000/api/v1
# - Android emulator:                  http://10.0.2.2:8000/api/v1
# - Physical phone (Expo Go):          http://<your-Mac-LAN-IP>:8000/api/v1   (e.g. http://192.168.1.20:8000/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# Change this to YOUR backend address for local testing. For APK builds, set it in eas.json too.
